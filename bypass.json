                                var w = excluirTicketServidor(ticketId);
                                ui.run(function () {
                                    mostrarSuporteStatus("Suporte", w.ok ? "Ticket excluído" : "Erro", w.ok ? "ok" : "erro", 4000);
                                    if (w.ok) renderAba();
                                });
                            });
                        });
                    });
                })(t.id);
                btnLayout.addView(bResp); btnLayout.addView(bStatus); btnLayout.addView(bDel); box.addView(btnLayout);
                listaTickets.addView(box);
