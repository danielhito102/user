        threads.start(function () {
            var r = baixarClientAtual();
            ui.run(function () { if (!r.ok) { mostrarSuporteStatus("Erro", "Falha ao baixar: " + r.erro, "erro", 4000); return; } ar.setText(r.texto); salvarTexto(CONFIG.ADMIN_DRAFT_FILE, r.texto); mostrarSuporteStatus("Sucesso", "Client baixado com sucesso", "ok", 4000); });
        });
    }));
    bar.addView(sm("💾 Salvar", TEMA.CARD_ALT, function () {
        var salvo = salvarTexto(CONFIG.ADMIN_DRAFT_FILE, String(ar.getText()));
        mostrarSuporteStatus("Rascunho", salvo ? "Rascunho salvo localmente" : "Erro ao salvar", salvo ? "ok" : "erro", 4000);
    }));
    bar.addView(sm("📂 Carregar", TEMA.CARD_ALT, function () {
        var t = carregarTexto(CONFIG.ADMIN_DRAFT_FILE);
        if (t) { ar.setText(t); mostrarSuporteStatus("Rascunho", "Rascunho carregado", "ok", 4000); }
        else mostrarSuporteStatus("Rascunho", "Nenhum rascunho encontrado", "aviso", 4000);
    }));
    var iv = novoInputLivre("Nova versao"); cp.addView(iv);
    var imn = novoInputLivre("Min versao"); cp.addView(imn);
    var ich = novoInputLivre("Changelog"); cp.addView(ich);
    var ob = false;
    var bo = novoBotao("Forcar: NAO", TEMA.CARD_ALT, 40, 12);
    bo.on("click", function () {
        ob = !ob; bo.setText("Forcar: " + (ob ? "SIM" : "NAO"));
        var bg = new GradientDrawable(); bg.setShape(GradientDrawable.RECTANGLE);
        bg.setColor(cor(ob ? TEMA.DANGER : TEMA.CARD_ALT)); bg.setCornerRadius(dp(8)); bo.setBackground(bg);
    });
    cp.addView(bo);
    var bp = novoBotao("🚀 PUBLICAR NO GITEA", TEMA.OK, 52, 14);
    bp.on("click", function () {
        var cd = String(ar.getText() || "");
        var vr = String(iv.getText() || "").trim();
        var mv = String(imn.getText() || "6.0").trim();
        var ch = String(ich.getText() || "").trim();
        if (!vr) { mostrarSuporteStatus("Aviso", "Informe a versão", "aviso", 4000); return; }
        var v = validarCodigo(cd);
        if (!v.ok) { dialogs.alert("Falhou", v.erros.join("\n")); return; }
        dialogs.confirm("Pub", "v" + vr + "?").then(function (ok) {
            if (!ok) return;
            threads.start(function () {
                var w = publicarAtualizacao(cd, vr, ch, ob, mv);
                ui.run(function () {
                    if (w.ok) { mostrarSuporteStatus("Publicação", "Versão v" + vr + " publicada com sucesso!", "ok", 5000); renderAba(); }
                    else { dialogs.alert("Erro", w.erro); }
                });
            });
        });
    });
    cp.addView(bp); host.addView(cp);
    threads.start(function () {
        var rM = ghLer(CONFIG.GH_ARQ_UPDATES);
        ui.run(function () {
            mb.removeAllViews();
            if (rM.ok) {
                var m = rM.dados;
                mb.addView(novoTexto("📦 v" + (m.versao || "?"), "#FFFFFF", 20, true));
                mb.addView(novoTexto((m.publicado_em || "-").slice(0, 19).replace("T", " "), "#E1BEE7", 11, false));
            } else {
                mb.addView(novoTexto("Nenhuma", "#E1BEE7", 12, false));
            }
        });
    });
}

