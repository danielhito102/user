            ui.badgeOnline.setText(online + " online • " + pags.length + " PIX • " + tics.length + " 🎫");
            function linha(l, v, cv) { var ll = new LinearLayout(context); ll.setOrientation(LinearLayout.HORIZONTAL); ll.setPadding(0, dp(6), 0, dp(6)); var a = novoTexto(l, TEMA.TEXT_DIM, 12, false); a.setLayoutParams(new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1)); ll.addView(a); ll.addView(novoTexto(v, cv || TEMA.TEXT, 14, true)); conteudo.addView(ll); }
            linha("Usuarios", String(Object.keys(clientes).length)); linha("Online", String(online), TEMA.OK); linha("Creditos", totalCred + " cred", TEMA.ACCENT); linha("Banidos", String(banidos.length), TEMA.DANGER); linha("PIX Pendentes", String(pags.length), TEMA.GOLD); linha("Tickets Abertos", String(tics.length), TEMA.PURPLE);
