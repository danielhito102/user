function renderUsuarios(host) {
    var cardBusca = novoCard(TEMA.CARD, 12, 12); cardBusca.addView(novoLabel("BUSCAR", TEMA.ACCENT)); var input = novoInputLivre("CPF ou nome..."); cardBusca.addView(input); host.addView(cardBusca);
