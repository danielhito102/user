ui.layout(<vertical bg="#0B0F14"><frame h="86" bg="#563d7c"><vertical padding="16 14"><text id="headerTitulo" text="GBot Admin (Runtime Dinâmico)" textColor="#FFFFFF" textSize="22sp" textStyle="bold"/><text id="headerSub" text="Console Conectado" textColor="#B2DFDB" textSize="11sp" marginTop="2"/></vertical><text id="badgeOnline" text="--" textColor="#FFD54F" textSize="11sp" textStyle="bold" layout_gravity="right|top" padding="16"/></frame><horizontal id="tabsBar" bg="#16202A" padding="4 4 4 4"/><scroll w="*" h="*"><vertical id="contentHost" padding="10"/></scroll></vertical>);

var TABS = [{ id: "dashboard", label: "📊" }, { id: "usuarios", label: "👥" }, { id: "pagamentos", label: "💰" }, { id: "suporte", label: "🎫" }, { id: "transacoes", label: "💳" }, { id: "presenca", label: "🟢" }, { id: "config", label: "⚙️" }, { id: "updates", label: "📦" }, { id: "banidos", label: "🚫" }, { id: "seguranca", label: "🔐" }];
var _abaAtual = "dashboard";

function gerenciarTimerAutoSync(idAba) {
    if (_timerAutoSync) { clearInterval(_timerAutoSync); _timerAutoSync = null; }
    _timerAutoSync = setInterval(function () {
        if (_abaAtual === idAba || _abaAtual === "dashboard" || _abaAtual === "pagamentos" || _abaAtual === "suporte") {
            renderAbaSilencioso();
        }
    }, 4000);
}

function renderTabs() { ui.run(function () { var bar = ui.tabsBar; bar.removeAllViews(); TABS.forEach(function (tab) { var ativo = (_abaAtual === tab.id); var b = new Button(context); b.setText(tab.label); b.setTextSize(14); b.setAllCaps(false); b.setTextColor(cor(ativo ? "#FFFFFF" : "#90A4AE")); var bg = new GradientDrawable(); bg.setShape(GradientDrawable.RECTANGLE); bg.setColor(cor(ativo ? TEMA.PRIMARY : TEMA.CARD)); bg.setCornerRadius(dp(6)); b.setBackground(bg); b.setPadding(0, 0, 0, 0); var lp = new LinearLayout.LayoutParams(0, dp(38), 1); lp.setMargins(dp(1), 0, dp(1), 0); b.setLayoutParams(lp); b.setMinHeight(0); b.setMinWidth(0); b.on("click", function () { trocarAba(tab.id); }); bar.addView(b); }); }); }
function trocarAba(id) { _abaAtual = id; gerenciarTimerAutoSync(id); renderTabs(); renderAba(); }
function renderAba() { ui.run(function () { var host = ui.contentHost; host.removeAllViews(); if (_abaAtual === "dashboard") renderDashboard(host); else if (_abaAtual === "usuarios") renderUsuarios(host); else if (_abaAtual === "pagamentos") renderPagamentos(host); else if (_abaAtual === "suporte") renderSuporte(host); else if (_abaAtual === "transacoes") renderTransacoes(host); else if (_abaAtual === "presenca") renderPresenca(host); else if (_abaAtual === "config") renderConfig(host); else if (_abaAtual === "updates") renderUpdates(host); else if (_abaAtual === "banidos") renderBanidos(host); else if (_abaAtual === "seguranca") renderSeguranca(host); }); }

function renderAbaSilencioso() {
    ui.run(function () {
        var host = ui.contentHost;
        if (_abaAtual === "pagamentos" && host.getChildCount() > 0) {
            threads.start(function () { ui.run(function () { try { renderPagamentos(host, true); } catch (e) {} }); });
        } else if (_abaAtual === "suporte" && host.getChildCount() > 0) {
            threads.start(function () { ui.run(function () { try { renderSuporte(host, true); } catch (e) {} }); });
        } else if (_abaAtual === "dashboard") {
            threads.start(function () {
                var rPag = giteaLerInstantaneo(CONFIG.GH_ARQ_PAGAMENTOS, true), rPres = giteaLerInstantaneo(CONFIG.GH_ARQ_PRESENCA, true), rSup = giteaLerInstantaneo(CONFIG.GH_ARQ_SUPORTE, true);
                var pags = (rPag.ok && rPag.dados.solicitacoes) ? rPag.dados.solicitacoes.filter(function (p) { return p.status === "pendente"; }) : [];
                var tics = (rSup.ok && rSup.dados.tickets) ? rSup.dados.tickets.filter(function (t) { return t.status === "aberto" || t.status === "em_andamento"; }) : [];
                var pres = (rPres.ok && rPres.dados.usuarios) ? rPres.dados.usuarios : {};
                var online = 0; for (var c in pres) if (estaOnline(pres[c].ultimo_ping)) online++;
                ui.run(function () { ui.badgeOnline.setText(online + " online • " + pags.length + " PIX • " + tics.length + " 🎫"); });
            });
        }
    });
}

function estaOnline(p) { try { return (Date.now() - new Date(p).getTime()) < (CONFIG.PRESENCA_ONLINE_MIN * 60000); } catch (e) { return false; } }

function renderDashboard(host) {
    var card = novoCard(TEMA.CARD, 14, 16); card.addView(novoLabel("VISÃO GERAL • RUNTIME DINÂMICO", TEMA.ACCENT)); var conteudo = new LinearLayout(context); conteudo.setOrientation(LinearLayout.VERTICAL); card.addView(conteudo); host.addView(card); conteudo.addView(novoTexto("Atualizando...", TEMA.TEXT_DIM, 12, false));
