var _filaEscrita={};
function validarIntegridadeDados(arq,dados){
    if(!dados||typeof dados!=="object")return false;
    var s=JSON.stringify(dados); if(s.length<10)return false;
    if(s.indexOf("<!DOCTYPE")!=-1||s.indexOf("<html")!=-1)return false;
    if(arq===CONFIG.GH_ARQ_LICENCAS){if(!dados.clientes||typeof dados.clientes!=="object")return false;}
    if(arq===CONFIG.GH_ARQ_CONFIG){if(!dados.regras||!dados.sistema)return false;}
    if(arq===CONFIG.GH_ARQ_TRANSACOES){if(!Array.isArray(dados.transacoes))return false;}
    if(arq===CONFIG.GH_ARQ_PAGAMENTOS){if(!Array.isArray(dados.solicitacoes))return false;}
    if(arq===CONFIG.GH_ARQ_SUPORTE){if(!Array.isArray(dados.tickets))return false;}
    return true;
}

const BASE_GITEA_API = `${CONFIG.GITEA_HOST}/api/v1/repos/${CONFIG.GH_USER}/${CONFIG.GH_REPO}`;

function giteaApiGet(path) {
    const url = path.startsWith("http") ? path : `${BASE_GITEA_API}${path}`;
    const res = http.get(url, {
        headers: {
            "Authorization": `token ${obterTokenGitea()}`,
            "Accept": "application/json",
            "User-Agent": "AutoJs6-GbotAdmin",
            "Cache-Control": "no-cache"
        },
        timeout: CONFIG.TIMEOUT_HTTP
    });
    const code = res.statusCode;
    const body = res.body ? res.body.string() : "";
    res.close && res.close();
    if (code < 200 || code >= 300) {
        throw new Error(`HTTP ${code} em ${url}\n${body}`);
    }
    return { code, body };
}

function giteaApiGetJson(path) {
    return JSON.parse(giteaApiGet(path).body);
}

function giteaLerInstantaneo(arq, forcar) {
    try {
        const data = giteaApiGetJson(`/contents/${arq}?ref=${CONFIG.GH_BRANCH}&timestamp=${Date.now()}`);
        let dados = null, sha = data.sha || null;
        if (data.content && data.encoding === "base64") {
            const b64 = data.content.replace(/\s/g, "");
            const dec = android.util.Base64.decode(b64, android.util.Base64.DEFAULT);
            try {
                dados = JSON.parse(new java.lang.String(dec, "UTF-8"));
            } catch (e) {
                dados = new java.lang.String(dec, "UTF-8");
            }
        } else {
            dados = data;
        }
        if (typeof dados === "object" && !validarIntegridadeDados(arq, dados)) {
            return { ok: false, erro: "Integridade inválida" };
        }
        return { ok: true, dados: dados, sha: sha, texto: typeof dados === "string" ? dados : null };
    } catch (e) {
        if (String(e).indexOf("HTTP 404") !== -1) {
            return { ok: false, erro: "HTTP 404", notFound: true };
        }
        return { ok: false, erro: String(e) };
    }
}
function ghLer(a) { return giteaLerInstantaneo(a, true); }

function giteaLerBase64(caminho) {
    try {
        const data = giteaApiGetJson(`/contents/${caminho}?ref=${CONFIG.GH_BRANCH}`);
        if (!data.content) return { ok: false, erro: "sem conteudo" };
        const cleanContent = data.content.replace(/[\r\n\s]/g, "");
        return { ok: true, bytes: android.util.Base64.decode(cleanContent, android.util.Base64.DEFAULT) };
    } catch (e) {
        return { ok: false, erro: String(e) };
    }
}
function ghLerBase64(c) { return giteaLerBase64(c); }

function giteaExcluirArquivoServidor(caminho, msg) {
    try {
        const token = obterTokenGitea();
        const url = `${BASE_GITEA_API}/contents/${caminho}`;
        const resGet = http.request(url + `?ref=${CONFIG.GH_BRANCH}&timestamp=${Date.now()}`, {
            method: "GET",
            headers: { "Authorization": "token " + token, "Accept": "application/json" },
            timeout: CONFIG.TIMEOUT_HTTP
        });
        if (!resGet || resGet.statusCode !== 200) return { ok: false, erro: "Arquivo nao encontrado" };
        const sha = JSON.parse(resGet.body.string()).sha;
        const payload = { message: msg || ("admin: delete " + caminho), sha: sha, branch: CONFIG.GH_BRANCH };
        const resDel = http.request(url, {
            method: "DELETE",
            headers: { "Authorization": "token " + token, "Accept": "application/json", "Content-Type": "application/json" },
            body: JSON.stringify(payload),
            timeout: CONFIG.TIMEOUT_HTTP
        });
        if (resDel && (resDel.statusCode === 200 || resDel.statusCode === 204)) { return { ok: true }; }
        return { ok: false, erro: "HTTP " + (resDel ? resDel.statusCode : 0) };
    } catch (e) {
        return { ok: false, erro: String(e) };
    }
}
function ghExcluirArquivoServidor(c, m) { return giteaExcluirArquivoServidor(c, m); }

function processarMapeamentoServidor(arq, dadosAtuais, objParaSalvar) {
    if (arq === CONFIG.GH_ARQ_CONFIG && dadosAtuais && typeof dadosAtuais === "object") {
        var merged = dadosAtuais;
        merged.visual = Object.assign({}, DEFAULT_FILES["config_remoto.json"].visual, merged.visual || {}, objParaSalvar.visual || {});
        merged.regras = Object.assign({}, DEFAULT_FILES["config_remoto.json"].regras, merged.regras || {}, objParaSalvar.regras || {});
        merged.sistema = Object.assign({}, DEFAULT_FILES["config_remoto.json"].sistema, merged.sistema || {}, objParaSalvar.sistema || {});
        return merged;
    } else if (arq === CONFIG.GH_ARQ_LICENCAS && dadosAtuais) {
        var merged = dadosAtuais;
        merged.clientes = merged.clientes || {};
        if (objParaSalvar.clientes) {
            for (var cpf in objParaSalvar.clientes) { merged.clientes[cpf] = objParaSalvar.clientes[cpf]; }
        }
        if (objParaSalvar.admin_snapshot) {
            merged.admin_snapshot = Object.assign(merged.admin_snapshot || {}, objParaSalvar.admin_snapshot);
        }
        return merged;
    } else if (arq === CONFIG.GH_ARQ_PAGAMENTOS && dadosAtuais && Array.isArray(dadosAtuais.solicitacoes)) {
        return objParaSalvar;
    } else if (arq === CONFIG.GH_ARQ_SUPORTE && dadosAtuais && Array.isArray(dadosAtuais.tickets)) {
        return objParaSalvar;
    }
    return objParaSalvar;
}

function giteaEscreverSeguro(arq, objOuTexto, msg, tent) {
    var isTexto = typeof objOuTexto === "string"; tent = tent || 3;
    if (_filaEscrita[arq]) return { ok: false, erro: "em fila" }; _filaEscrita[arq] = true;
    try {
        for (var t = 0; t < tent; t++) {
            var token = obterTokenGitea(); if (!token) return { ok: false, erro: "Token" };
            var url = `${BASE_GITEA_API}/contents/${arq}`;
            var resGet = http.request(url + `?ref=${CONFIG.GH_BRANCH}&timestamp=${Date.now()}`, {
                method: "GET",
                headers: { "Authorization": "token " + token, "Accept": "application/json" },
                timeout: CONFIG.TIMEOUT_HTTP
            });
            var shaAtual = null, dadosAtuais = null;
            if (resGet && resGet.statusCode === 200) {
                try {
                    var j = JSON.parse(resGet.body.string());
                    shaAtual = j.sha;
                    if (j.content && !isTexto) {
                        var dec = android.util.Base64.decode(j.content.replace(/\n/g, ""), 0);
                        dadosAtuais = JSON.parse(new java.lang.String(dec, "UTF-8"));
                    }
                } catch (e) {}
            }
            var objFinal = isTexto ? objOuTexto : processarMapeamentoServidor(arq, dadosAtuais, objOuTexto);
            var conteudoFinal = isTexto ? objFinal : JSON.stringify(objFinal, null, 2);
            if (!isTexto && !validarIntegridadeDados(arq, objFinal)) return { ok: false, erro: "Objeto invalido mapeado" };
            var b64 = android.util.Base64.encodeToString(new java.lang.String(conteudoFinal).getBytes("UTF-8"), 0).replace(/\n/g, "");
            var payload = { message: msg || ("admin: update " + arq), content: b64, branch: CONFIG.GH_BRANCH };
            if (shaAtual) payload.sha = shaAtual;
            var resPut = http.request(url, {
                method: "PUT",
                headers: { "Authorization": "token " + token, "Accept": "application/json", "Content-Type": "application/json" },
                body: JSON.stringify(payload),
                timeout: CONFIG.TIMEOUT_HTTP
            });
            if (resPut && (resPut.statusCode === 200 || resPut.statusCode === 201)) { return { ok: true, criado: !shaAtual }; }
            if (resPut && (resPut.statusCode === 409 || resPut.statusCode === 422)) continue;
            if (t === tent - 1) return { ok: false, erro: "HTTP " + (resPut ? resPut.statusCode : 0) };
        }
        return { ok: false, erro: "Max tentativas" };
    } finally { _filaEscrita[arq] = false; }
}
function ghEscrever(a, o, m) { return giteaEscreverSeguro(a, o, m, 3); }

function autoRepararArquivos() {
    var arquivos = Object.keys(DEFAULT_FILES);
    var reparados = [], criados = [];
    for (var i = 0; i < arquivos.length; i++) {
        var nome = arquivos[i]; var padrao = DEFAULT_FILES[nome]; var r = giteaLerInstantaneo(nome, true);
        if (!r.ok && r.notFound) { var w = ghEscrever(nome, padrao, "admin: auto-create " + nome); if (w.ok) criados.push(nome); }
        else if (r.ok) {
            var dados = r.dados || {}; var precisaAtualizar = false;
            for (var chave in padrao) {
                if (dados[chave] === undefined || dados[chave] === null) { dados[chave] = padrao[chave]; precisaAtualizar = true; }
                else if (typeof padrao[chave] === "object" && padrao[chave] !== null && !Array.isArray(padrao[chave])) {
                    for (var subChave in padrao[chave]) {
                        if (dados[chave][subChave] === undefined) { dados[chave][subChave] = padrao[chave][subChave]; precisaAtualizar = true; }
                    }
                }
            }
            if (precisaAtualizar) { var w = ghEscrever(nome, dados, "admin: auto-fix " + nome); if (w.ok) reparados.push(nome); }
        }
    }
    return { criados: criados, reparados: reparados };
}

