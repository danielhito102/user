function fluxoCriarPin() { ui.run(function () { ui.contentHost.removeAllViews(); ui.tabsBar.removeAllViews(); ui.headerTitulo.setText("GBot Admin"); ui.headerSub.setText("Criar PIN"); var c = novoCard(TEMA.CARD, 14, 20); c.addView(novoLabel("PRIMEIRO ACESSO", TEMA.ACCENT)); c.addView(novoTexto("Crie PIN master", TEMA.TEXT, 22, true)); var i1 = novoInputLivre("Novo PIN"); c.addView(i1); var i2 = novoInputLivre("Confirme"); c.addView(i2); var er = novoTexto("", TEMA.DANGER, 11, false); c.addView(er); var b = novoBotao("Criar", TEMA.OK, 48, 14); b.on("click", function () { var p1 = String(i1.getText() || ""), p2 = String(i2.getText() || ""); if (p1.length < CONFIG.MIN_PIN_LEN) { er.setText("Min " + CONFIG.MIN_PIN_LEN); return; } if (p1 !== p2) { er.setText("!="); return; } if (!salvarPin(sha256(p1))) { er.setText("Err"); return; } salvarSessao({ nome: "master", ts: new Date().toISOString() }); logAcao("pin_criado", {}); iniciarPainel(); }); c.addView(b); ui.contentHost.addView(c); }); }
function fluxoPedirPin() { ui.run(function () { ui.contentHost.removeAllViews(); ui.tabsBar.removeAllViews(); ui.headerTitulo.setText("GBot Admin"); ui.headerSub.setText("Acesso restrito"); var c = novoCard(TEMA.CARD, 14, 20); c.addView(novoLabel("ADMIN", TEMA.ACCENT)); c.addView(novoTexto("Digite seu PIN", TEMA.TEXT, 22, true)); var i = novoInputLivre("PIN"); c.addView(i); var er = novoTexto("", TEMA.DANGER, 11, false); c.addView(er); var b = novoBotao("Entrar", TEMA.PRIMARY, 48, 14); var tn = 0; b.on("click", function () { var p = String(i.getText() || ""); if (!p) { er.setText("Digite"); return; } if (!verificarPin(p)) { tn++; er.setText("Incorreto (" + tn + "/5)"); i.setText(""); if (tn >= 5) { b.setEnabled(false); er.setText("Bloq 30s"); setTimeout(function () { tn = 0; b.setEnabled(true); er.setText(""); }, 30000); } return; } salvarSessao({ nome: "master", ts: new Date().toISOString() }); logAcao("login", {}); iniciarPainel(); }); c.addView(b); ui.contentHost.addView(c); }); }
function iniciarPainel() { ui.run(function () { ui.headerTitulo.setText("GBot Admin (Runtime)"); ui.headerSub.setText("v" + CONFIG.APP_VERSION); }); renderTabs(); trocarAba("dashboard"); }

function boot() {
    garantirPastaAdmin();
    if (!obterTokenGitea()) { mostrarSuporteStatus("Alerta", "Token Gitea não configurado", "aviso", 6000); }
    threads.start(function () {
        var rep = autoRepararArquivos();
        if (rep.criados.length > 0 || rep.reparados.length > 0) {
            mostrarSuporteStatus("Auto-Reparo", "Arquivos ajustados: " + (rep.criados.length + rep.reparados.length), "ok", 5000);
        }
    });
    if (!pinExiste()) { fluxoCriarPin(); return; }
    var sess = carregarSessao();
    if (sess && sess.nome) {
        threads.start(function () { ui.run(iniciarPainel); });
        return;
    }
    fluxoPedirPin();
}
setTimeout(function () { try { boot(); } catch (e) { console.error("boot", e); mostrarSuporteStatus("Erro Boot", String(e), "erro", 6000); } }, 300);
