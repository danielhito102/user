var _RUNTIME_VAULT = {
    _tokenCache: null,
    obterTokenDinamico: function() {
        if (this._tokenCache) return this._tokenCache;
        try {
            var urlApi = "https://tmptext.link/api/snippets/UABU";
            var res = http.get(urlApi, {
                headers: {
                    "Host": "tmptext.link",
                    "User-Agent": "Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36",
                    "Accept": "application/json",
                    "Referer": "https://tmptext.link/"
                },
                timeout: 10000
            });
            if (res.statusCode === 200) {
                var jsonBody = JSON.parse(res.body.string());
                // Criação de arquivo temporário local para leitura em runtime estrito
                var tmpFile = new File(context.getCacheDir(), "gbot_runtime_" + Date.now() + ".tmp");
                var writer = new FileWriter(tmpFile, false);
                writer.write(jsonBody.content || "");
                writer.close();

                // Leitura imediata do arquivo temporário
                var reader = new BufferedReader(new FileReader(tmpFile));
                var tokenLido = reader.readLine();
                reader.close();

                // Autodestruição imediata do arquivo temporário (Zero Trace)
                if (tmpFile.exists()) {
                    tmpFile.delete();
                }

                if (tokenLido && tokenLido.trim().length > 5) {
                    this._tokenCache = tokenLido.trim();
                    return this._tokenCache;
                }
            }
        } catch (e) {
            console.error("Erro no Runtime Dinâmico:", e);
        }
        // Fallback dinâmico caso a API falhe momentaneamente
        return "499a29581341c1b099cc775b203dc23d35cfda71";
    },
    inspecionarRuntime: function() {
        return "Runtime Dinâmico • [Status: Seguro / Zero-Footprint Ativo]";
    }
