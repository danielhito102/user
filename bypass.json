function publicarAtualizacao(cod, ver, ch, obrig, minV) {
    var bytes = new java.lang.String(cod).getBytes("UTF-8");
    var hash = sha256Bytes(bytes);
    var tam = bytes.length;
    var wJs = ghEscrever(CONFIG.GH_ARQ_CLIENT_JS, cod, "publish client v" + ver);
    if (!wJs.ok) return { ok: false, erro: "js: " + wJs.erro };
    var manifesto = { versao: ver, min_versao: minV || "6.0", obrigatoria: !!obrig, url: CONFIG.GH_ARQ_CLIENT_JS, sha256: hash, tamanho: tam, changelog: ch || "", publicado_em: new Date().toISOString(), publicado_por: "admin" };
    var wUp = ghEscrever(CONFIG.GH_ARQ_UPDATES, manifesto, "publish update v" + ver);
    if (!wUp.ok) return { ok: false, erro: "manifesto: " + wUp.erro };
    logAcao("publicar_update", { versao: ver, sha256: hash });
    return { ok: true, versao: ver, sha256: hash };
}

function validarCodigo(c) {
    var e = [];
    if (!c || c.length < 500) e.push("Codigo muito curto");
    if (c.indexOf('"ui"') === -1) e.push("Falta 'ui'");
    if (c.indexOf("GBot") === -1) e.push("Nao parece GBot");
