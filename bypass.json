function abrirOuBaixarDocumento(urlComp) {
    if (!urlComp) { mostrarSuporteStatus("Arquivo", "Nenhum documento vinculado", "aviso", 4000); return; }
    threads.start(function () {
        try {
            var nomeArq = urlComp.split("/").pop() || ("doc_" + Date.now() + ".bin");
            var pastaLocal = new File("/sdcard/GBotAdmin/baixados/");
            if (!pastaLocal.exists()) pastaLocal.mkdirs();
            var fLocal = new File(pastaLocal, nomeArq);
            mostrarSuporteStatus("Download", "Iniciando download e checagem...", "suporte", 5000);
            var res = ghLerBase64(urlComp);
            if (!res.ok) { mostrarSuporteStatus("Erro", "Falha ao baixar arquivo: " + res.erro, "erro", 5000); return; }
            var fos = new java.io.FileOutputStream(fLocal);
            fos.write(res.bytes);
            fos.close();
            ui.run(function () {
                dialogs.confirm("Abrir Arquivo Original", "Arquivo salvo em /sdcard/GBotAdmin/baixados/" + nomeArq + " (" + res.bytes.length + " bytes). Deseja abrir agora?").then(function (ok) {
                    if (!ok) return;
                    try {
                        var intent = new Intent(Intent.ACTION_VIEW);
                        var uri;
                        try { uri = FileProvider.getUriForFile(context, context.getPackageName() + ".fileprovider", fLocal); }
                        catch (fpErr) { uri = FileProvider.getUriForFile(context, context.getPackageName() + ".provider", fLocal); }
                        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
                        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                        var mime = "*/*";
                        var lowerName = nomeArq.toLowerCase();
                        if (lowerName.endsWith(".pdf")) mime = "application/pdf";
                        else if (lowerName.endsWith(".jpg") || lowerName.endsWith(".jpeg")) mime = "image/jpeg";
                        else if (lowerName.endsWith(".png")) mime = "image/png";
                        else if (lowerName.endsWith(".txt")) mime = "text/plain";
                        else if (lowerName.endsWith(".json")) mime = "application/json";
                        intent.setDataAndType(uri, mime);
                        context.startActivity(intent);
                        mostrarSuporteStatus("Visualizador", "Abrindo visualizador externo", "ok", 4000);
                    } catch (err) {
                        try {
                            var intentFb = new Intent(Intent.ACTION_VIEW);
                            intentFb.setDataAndType(Uri.fromFile(fLocal), "*/*");
                            intentFb.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                            context.startActivity(intentFb);
                            mostrarSuporteStatus("Visualizador", "Abrindo via fallback", "ok", 4000);
                        } catch (e2) {
                            mostrarSuporteStatus("Erro", "Falha ao abrir visualizador: " + e2, "erro", 5000);
                        }
                    }
                });
            });
        } catch (e) {
            mostrarSuporteStatus("Erro", "Exceção no processamento: " + e, "erro", 5000);
        }
    });
}

