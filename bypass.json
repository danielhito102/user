    function renderLista(filtro) {
        lista.removeAllViews(); lista.addView(novoTexto("Carregando...", TEMA.TEXT_DIM, 12, false));
        threads.start(function () {
            var rLic = ghLer(CONFIG.GH_ARQ_LICENCAS), rBan = ghLer(CONFIG.GH_ARQ_BANIDOS), rPres = ghLer(CONFIG.GH_ARQ_PRESENCA);
            var clientes = (rLic.ok && rLic.dados.clientes) ? rLic.dados.clientes : {};
            var snap = (rLic.ok && rLic.dados.admin_snapshot) ? rLic.dados.admin_snapshot : {};
            var banidos = (rBan.ok && rBan.dados.cpfs_bloqueados) ? rBan.dados.cpfs_bloqueados : [];
            var pres = (rPres.ok && rPres.dados.usuarios) ? rPres.dados.usuarios : {};
