function sha256(str){try{var md=MessageDigest.getInstance("SHA-256");var b=md.digest(new java.lang.String(str).getBytes("UTF-8"));var sb="";for(var i=0;i<b.length;i++)sb+=("0"+(b[i]&0xFF).toString(16)).slice(-2);return sb;}catch(e){return "";}}
function sha256Bytes(bytes){try{var md=MessageDigest.getInstance("SHA-256");md.update(bytes);var b=md.digest();var sb="";for(var i=0;i<b.length;i++)sb+=("0"+(b[i]&0xFF).toString(16)).slice(-2);return sb;}catch(e){return "";}}

